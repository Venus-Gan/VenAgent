# VenAgent 本地开发配置模板。
# 复制为 .env 后按需修改；显式进程环境变量始终覆盖本文件。
# 生产环境应由部署平台或 Secret Manager 注入变量，不要提交真实秘密。

# SERVER__PORT: HTTP 服务端口。允许范围为 1..65535，未设置时使用 8090。
SERVER__PORT=8090

# PERSISTENCE__ENABLED: PostgreSQL 业务持久化开关。false 时使用进程内 temporary adapter。
PERSISTENCE__ENABLED=true
# PERSISTENCE__HOST: PostgreSQL 容器映射到宿主机的地址。
PERSISTENCE__HOST=127.0.0.1
# PERSISTENCE__PORT: PostgreSQL 容器映射到宿主机的端口。
PERSISTENCE__PORT=5432
# PERSISTENCE__DATABASE: 应用数据库名；生成 DSN 时会安全编码。
PERSISTENCE__DATABASE=venagent
# PERSISTENCE__USER: 连接 PostgreSQL 的最小权限数据库用户。
PERSISTENCE__USER=venagent
# POSTGRES_PASSWORD: Compose 初始化和应用连接共用的 PostgreSQL 密码，必须替换。
POSTGRES_PASSWORD=replace-with-a-local-password

# NEO4J__ENABLED: 启用 M05 GraphMemory；容器不可用时普通长期事实仍可召回。
NEO4J__ENABLED=true
# NEO4J__URI: 当前应用运行在宿主机，因此连接 Compose 映射的 Bolt 端口。
NEO4J__URI=bolt://127.0.0.1:7687
NEO4J__DATABASE=neo4j
NEO4J__USER=neo4j
# NEO4J_PASSWORD: Compose 初始化与应用连接共用；不要提交真实秘密。
NEO4J_PASSWORD=
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J__MAX_POOL_SIZE=10
NEO4J__CONNECTION_TIMEOUT=2
NEO4J__ACQUISITION_TIMEOUT=2
NEO4J__READ_TIMEOUT=0.1
NEO4J__WRITE_TIMEOUT=30

# AUTH__ISSUER: JWT 签发者标识。
AUTH__ISSUER=venagent
# AUTH__AUDIENCE: 浏览器客户端的 JWT audience。
AUTH__AUDIENCE=venagent-web
# AUTH__COOKIE_SECURE: HTTPS 部署必须为 true；本地 HTTP 开发保持 false。
AUTH__COOKIE_SECURE=false
# AUTH__ALLOWED_ORIGINS_JSON: 允许携带凭据调用 API 的前端源 JSON 字符串数组。
AUTH__ALLOWED_ORIGINS_JSON=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:8090","http://localhost:8090"]
# JWT_SECRET: durable 身份需要的至少 32 字节随机秘密；缺失时只启用临时匿名模式。
JWT_SECRET=replace-with-at-least-32-random-bytes

# LLM_PROVIDER: 模型提供商；所有 LLM_* 留空时使用无网络本地模型。
LLM_PROVIDER=
# LLM_API_KEY: 模型提供商 API 密钥。
LLM_API_KEY=
# LLM_MODEL: 要调用的模型标识。
LLM_MODEL=
# LLM_API_MODE: OpenAI-family 请求模式，可选 chat_completions 或 responses。
LLM_API_MODE=chat_completions
# LLM_BASE_URL: SDK API root；与 LLM_ENDPOINT_URL 二者只能选一个。
LLM_BASE_URL=
# LLM_ENDPOINT_URL: 完整资源地址；与 LLM_BASE_URL 二者只能选一个。
LLM_ENDPOINT_URL=
# LLM_AZURE_ENDPOINT: Azure OpenAI 服务端点。
LLM_AZURE_ENDPOINT=
# LLM_AZURE_DEPLOYMENT: Azure OpenAI 部署名称。
LLM_AZURE_DEPLOYMENT=
# LLM_API_VERSION: Azure OpenAI API 版本。
LLM_API_VERSION=
# LLM_REASONING_EFFORT: 可选推理强度；空值表示不传给 provider。
LLM_REASONING_EFFORT=
# LLM_TEMPERATURE: 可选采样温度；空值表示不传给 provider。
LLM_TEMPERATURE=
# LLM_MAX_TOKENS: 可选单次生成 token 上限；空值表示不传给 provider。
LLM_MAX_TOKENS=
# LLM_TIMEOUT: 可选请求超时秒数；空值表示不传给 provider。
LLM_TIMEOUT=
# LLM_MAX_RETRIES: 可选请求重试次数；空值表示不传给 provider。
LLM_MAX_RETRIES=
# LLM_VERBOSITY: 可选输出详细度；空值表示不传给 provider。
LLM_VERBOSITY=
# LLM_EXTRA_BODY_JSON: Provider 扩展参数 JSON object，不能覆盖认证或类型化字段。
LLM_EXTRA_BODY_JSON=

# MEMORY_EXTRACTOR_* 全空时复用当前对话模型；仅设置 MODEL 时继承主模型连接 profile。
MEMORY_EXTRACTOR_PROVIDER=
MEMORY_EXTRACTOR_API_KEY=
MEMORY_EXTRACTOR_MODEL=
MEMORY_EXTRACTOR_API_MODE=chat_completions
MEMORY_EXTRACTOR_BASE_URL=
MEMORY_EXTRACTOR_ENDPOINT_URL=
MEMORY_EXTRACTOR_AZURE_ENDPOINT=
MEMORY_EXTRACTOR_AZURE_DEPLOYMENT=
MEMORY_EXTRACTOR_API_VERSION=
MEMORY_EXTRACTOR_TEMPERATURE=
MEMORY_EXTRACTOR_MAX_TOKENS=
MEMORY_EXTRACTOR_TIMEOUT=
MEMORY_EXTRACTOR_MAX_RETRIES=
MEMORY_EXTRACTOR_EXTRA_BODY_JSON=

# EMBEDDING_* 必须三项同时设置；全空时语义索引明确 disabled，slot 召回仍可用。
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT=10
EMBEDDING_MAX_RETRIES=2

# TEST_DATABASE_URL: pytest 的 PostgreSQL 集成测试连接，必须指向独立的 venagent_test 数据库。
TEST_DATABASE_URL=
# TEST_NEO4J_URI 必须指向隔离测试容器；留空时真实 Neo4j 测试明确 skipped。
TEST_NEO4J_URI=
